{
  "name": "dsh-skill-router",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle: decide which skill handles a request, confirm once, then reuse. Ships a Skills view with per-turn skill paths, ratings and GitHub star links.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "router"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills/**/SKILL.md",
    "assets",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/renzg/skill-router.git"
  },
  "homepage": "https://github.com/renzg/skill-router#readme",
  "bugs": {
    "url": "https://github.com/renzg/skill-router/issues"
  }
}
